{
  "name": "opencode-preview",
  "version": "0.1.0",
  "description": "OpenCode v2 TUI plugin: /preview <path> renders files in the terminal — images, PDFs (rasterized), and text files in a built-in vim-style editor.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "ItheaValgulious",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "vim",
    "image",
    "pdf",
    "typescript"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "vim",
    "viewer",
    "util",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "test:unit": "node --experimental-strip-types --test test/engine.test.ts test/util.test.ts"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.4.1",
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.9",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  }
}
